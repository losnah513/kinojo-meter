<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LauncherVersion Condition="'$(LauncherVersion)' == ''">0.0.0</LauncherVersion>
    <LauncherFileVersion Condition="'$(LauncherFileVersion)' == ''">0.0.0.0</LauncherFileVersion>
    <Version>$(LauncherVersion)</Version>
    <AssemblyVersion>$(LauncherFileVersion)</AssemblyVersion>
    <FileVersion>$(LauncherFileVersion)</FileVersion>
    <InformationalVersion>$(LauncherVersion)</InformationalVersion>
    <AssemblyTitle>KINOJO Meter Launcher</AssemblyTitle>
    <Product>KINOJO Meter Launcher</Product>
    <Company>KINOJO INFO</Company>
    <AssemblyName Condition="'$(LauncherChannel)' != 'staging'">KINOJO.Meter.Launcher</AssemblyName>
    <AssemblyName Condition="'$(LauncherChannel)' == 'staging'">KINOJO.Meter.Launcher.Staging</AssemblyName>
    <RootNamespace>KinojoMeterLauncher</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\assets\kinojo-updater-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <DefineConstants Condition="'$(LauncherChannel)' == 'staging'">$(DefineConstants);KINOJO_STAGING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LauncherBuildProfile.cs" />
    <Compile Include="LauncherPassKeyContract.cs" />
    <Compile Include="LauncherLoginForm.cs" />
    <Compile Include="LauncherForm.cs" />
    <Compile Include="LauncherVisualControls.cs" />
    <Compile Include="LauncherApiClient.cs" />
    <Compile Include="LauncherContentClient.cs" />
    <Compile Include="LauncherUpdateService.cs" />
    <Compile Include="CorePackageInstaller.cs" />
    <Compile Include="CoreUpdateHandoffMode.cs" />
    <Compile Include="CoreReleaseIntegrityVerifier.cs" />
    <Compile Include="UiAssetPackInstaller.cs" />
    <Compile Include="UiAssetPackageValidator.cs" />
    <Compile Include="UiAssetPackState.cs" />
    <Compile Include="UiAssetReleaseIntegrityVerifier.cs" />
    <Compile Include="ModulePackageDownloadCache.cs" />
    <Compile Include="ModulePackageVerifier.cs" />
    <Compile Include="ModuleStagingInstaller.cs" />
    <Compile Include="ModuleStagingSelfTest.cs" />
    <Compile Include="ModuleBundleServerPointer.cs" />
    <Compile Include="ModuleBundleActivator.cs" />
    <Compile Include="ModuleBundleRollback.cs" />
    <Compile Include="ModuleDamagedPackageRepair.cs" />
    <Compile Include="ShellModuleUpdater.cs" />
    <Compile Include="PrivateRuntimePackageUpdater.cs" />
    <Compile Include="CaptureModuleUpdater.cs" />
    <Compile Include="ProtocolModuleUpdater.cs" />
    <Compile Include="SyncModuleUpdater.cs" />
    <Compile Include="CatalogPackUpdater.cs" />
    <Compile Include="LauncherModels.cs" />
    <Compile Include="LauncherPaths.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
