<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\launcher\LauncherBuildProfile.cs" Link="LauncherBuildProfile.cs" />
    <Compile Include="..\..\launcher\LauncherPaths.cs" Link="LauncherPaths.cs" />
    <Compile Include="..\..\launcher\ModulePackageDownloadCache.cs" Link="ModulePackageDownloadCache.cs" />
    <Compile Include="..\..\launcher\ModulePackageVerifier.cs" Link="ModulePackageVerifier.cs" />
    <Compile Include="..\..\launcher\ModuleStagingInstaller.cs" Link="ModuleStagingInstaller.cs" />
    <Compile Include="..\..\launcher\ModuleStagingSelfTest.cs" Link="ModuleStagingSelfTest.cs" />
    <Compile Include="..\..\launcher\ModuleBundleActivator.cs" Link="ModuleBundleActivator.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
